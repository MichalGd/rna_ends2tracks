# Copy the original samplesheet; fill assembly-matched reference paths.
PROJECT_ID=mouse_gex_v1
SAMPLESHEET=samplesheet.csv
OUTPUT_DIR=/dysk3/micgdu/Analysis/run11_quanSeq/mouse_gex_v1/results
TMP_DIR=/dysk3/micgdu/Analysis/run11_quanSeq/mouse_gex_v1/tmp
INPUT_MODE=bam
ALIGNMENT_SOURCE_DIR=/dysk3/micgdu/Analysis/run11_quanSeq/mouse/results/02_alignment
MM39_GTF=/replace/with/original/gencode.annotation.gtf
MM39_CHROM_SIZES=/replace/with/original/GRCm39.chrom.sizes
LIBRARY_PROTOCOL=quantseq_rev_v2_se
LIBRARY_LAYOUT=single_end
UMI_PRESENT=false
DESIGN="~ condition"
PAIRING_MODE=none
# Preserve the original CONDITION_ORDER if its contrast directions were customized.
RUN_GENE_EXPRESSION=true
DGE_METHODS=extended_exons_v1
DGE_PRIMARY_METHOD=extended_exons_v1
GEX_EXTENSION_MAX_NT=6000
GEX_TSS_BUFFER_NT=2000
GEX_FILTER_METHOD=filterByExpr
GEX_MIN_COUNT=5
GEX_MIN_TOTAL_COUNT=15
RUN_DGE_STRINGENT=true
RUN_DGE_RELAXED=true
DGE_STRINGENT_LFC_THRESHOLD=1.0
FDR=0.05
RUN_DGE_ENRICHMENT=true
ENRICHMENT_ORA=true
ENRICHMENT_GSEA=true
RUN_APA_ENRICHMENT=false
RUN_APA_A_MCELL2019=false
RUN_APA_A2=false
RUN_APA_B=false
RUN_RSEQC=false
RUN_TRACKS=false
CLEANUP_INTERMEDIATES=false
MAX_TOTAL_THREADS=80
MAX_TOTAL_MEMORY_GB=384
DGE_CONTRAST_PARALLEL_JOBS=8
ENRICHMENT_PARALLEL_JOBS=8
# Historical alignment allocation; no alignments run in INPUT_MODE=bam.
STAR_PARALLEL_JOBS=8
STAR_THREADS=10
